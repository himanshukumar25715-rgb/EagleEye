# Eagle Eye AI - Environment Configuration Template

# Nodemailer / Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME="Campus Security"
SMTP_FROM_EMAIL=your_email@gmail.com

# Automated End-of-Day Dispatch Settings
REPORT_DEFAULT_RECIPIENT=security@campus.edu
AUTO_REPORT_ENABLED=true
AUTO_REPORT_HOUR=23
AUTO_REPORT_MINUTE=59
